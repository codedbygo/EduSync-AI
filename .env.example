# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Whisper model for local transcription: tiny, base, small
WHISPER_MODEL=base
MAX_UPLOAD_MB=500
# Local working folder; also holds the SQLite database and stored files when the Supabase settings below are empty
DATA_DIR=
# Permanent records (needed on Render, whose disk is wiped on every restart). Supabase free tier, no card:
# Project Settings > Database > Connection string > "Session pooler" (IPv4; the direct host is IPv6-only and fails on Render)
DATABASE_URL=
# Project Settings > API: Project URL and the service_role key (server only, never in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=edusync

# Provider: gemini (default) | ollama (local, no key, no quota) | auto (Gemini, then local if Gemini fails)
LLM_PROVIDER=gemini
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_URL=http://localhost:11434
# Optional: grade with a different model family as grader B (e.g. ollama) so their errors rarely coincide
GRADER_B_PROVIDER=ollama
# Free NVIDIA/Google vision models via OpenRouter (key without card: https://openrouter.ai/keys). Used with LLM_PROVIDER=openrouter, or as the 2nd step of LLM_PROVIDER=auto (Gemini, OpenRouter, Ollama)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free
